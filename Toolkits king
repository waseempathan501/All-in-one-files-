<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover">
<title>WASEEM HACKER STORE | HACKING STORE</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
}

body {
    font-family: 'Segoe UI', 'Poppins', system-ui, monospace;
    background: black;
    color: #ff3333;
    overflow: hidden;
    height: 100vh;
    width: 100vw;
    position: fixed;
    top: 0;
    left: 0;
    overscroll-behavior: none;
}

canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: -1;
    pointer-events: none;
}

#app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    width: 100vw;
    position: relative;
    z-index: 1;
    opacity: 1;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: rgba(0,0,0,0.85);
    border-bottom: 2px solid #ff2222;
    backdrop-filter: blur(4px);
    flex-shrink: 0;
}

.header-left {
    display: flex;
    align-items: center;
    gap: 12px;
}

header h2 {
    margin: 0;
    text-shadow: 0 0 8px #ff0000, 0 0 12px #ff4444;
    font-size: 1.1rem;
    letter-spacing: 1px;
}

.header-right {
    display: flex;
    gap: 8px;
    align-items: center;
}

/* Server Toggle Button */
.server-toggle {
    background: rgba(255, 0, 0, 0.2);
    border: 1px solid #ff3333;
    border-radius: 50px;
    padding: 6px 12px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    box-shadow: 0 0 4px rgba(255, 0, 0, 0.5);
}

.server-toggle:active {
    transform: scale(0.95);
}

.server-toggle .antenna-small {
    font-size: 1.1rem;
}

.server-toggle .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}

.server-toggle.connected {
    border-color: #ff5555;
    background: rgba(255, 80, 80, 0.25);
    box-shadow: 0 0 8px #ff3333;
}

.server-toggle.connected .status-dot {
    background: #ff3333;
    box-shadow: 0 0 6px #ff0000;
    animation: pulse 1.5s ease-in-out infinite;
}

.server-toggle.disconnected {
    border-color: #ff6666;
    background: rgba(180, 0, 0, 0.3);
}

.server-toggle.disconnected .status-dot {
    background: #ff6666;
}

@keyframes pulse {
    0%, 100% { opacity: 0.5; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
}

.waves-small {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-left: 4px;
}

.waves-small span {
    width: 2px;
    background: #ff4444;
    border-radius: 1px;
    animation: waveAnim 0.8s ease-in-out infinite;
}

.waves-small span:nth-child(1) { height: 6px; animation-delay: 0s; }
.waves-small span:nth-child(2) { height: 10px; animation-delay: 0.1s; }
.waves-small span:nth-child(3) { height: 8px; animation-delay: 0.2s; }
.waves-small span:nth-child(4) { height: 5px; animation-delay: 0.3s; }

@keyframes waveAnim {
    0%, 100% { opacity: 0.3; transform: scaleY(0.7); }
    50% { opacity: 1; transform: scaleY(1.2); }
}

/* Notification Button */
.notif-btn {
    background: rgba(255, 0, 0, 0.2);
    border: 1px solid #ff3333;
    border-radius: 50px;
    padding: 6px 12px;
    cursor: pointer;
    font-size: 1rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 6px;
    position: relative;
    box-shadow: 0 0 4px rgba(255, 0, 0, 0.4);
}

.notif-btn:active {
    transform: scale(0.95);
}

.notif-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #ff3366;
    color: white;
    font-size: 0.6rem;
    padding: 2px 6px;
    border-radius: 20px;
    font-weight: bold;
    min-width: 18px;
    text-align: center;
}

.search-section {
    display: flex;
    gap: 10px;
    padding: 12px 16px;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    flex-shrink: 0;
    align-items: center;
    position: relative;
    z-index: 100;
}

.search-wrapper {
    flex: 1;
}

.search-wrapper input {
    width: 100%;
    padding: 10px 18px;
    border-radius: 40px;
    border: 2px solid #ff3333;
    background: rgba(0,0,0,0.85);
    color: #ff6666;
    font-size: 1rem;
    outline: none;
    transition: all 0.3s ease;
    box-shadow: 0 0 6px rgba(255, 0, 0, 0.3);
}

.search-wrapper input:focus {
    border-color: #ff5555;
    box-shadow: 0 0 12px #ff0000;
}

.menu-btn {
    background: rgba(20, 0, 0, 0.9);
    color: #ff3333;
    border: 1px solid #ff3333;
    font-size: 1.8rem;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 44px;
    letter-spacing: 2px;
    position: relative;
    z-index: 101;
    box-shadow: 0 0 5px rgba(255, 0, 0, 0.5);
}

.menu-btn:active {
    transform: scale(0.94);
    background: rgba(255, 0, 0, 0.3);
}

.dropdown {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    background: #0a0505;
    border: 1px solid #ff3333;
    border-radius: 16px;
    display: none;
    min-width: 200px;
    z-index: 9999;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 30px rgba(255, 0, 0, 0.5);
    overflow: hidden;
    animation: menuSlideDown 0.22s ease-out;
}

@keyframes menuSlideDown {
    from {
        opacity: 0;
        transform: translateY(-12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.dropdown-item {
    padding: 14px 20px;
    cursor: pointer;
    color: #ff6666;
    transition: 0.2s;
    font-size: 0.95rem;
    text-align: left;
    border-bottom: 1px solid rgba(255, 51, 51, 0.2);
    display: flex;
    align-items: center;
    gap: 14px;
    font-weight: 500;
}

.dropdown-item:last-child {
    border-bottom: none;
}

.dropdown-item:hover {
    background: rgba(255, 0, 0, 0.2);
    padding-left: 26px;
    color: #ff8888;
}

.dropdown-item .icon {
    font-size: 1.2rem;
    min-width: 28px;
    text-align: center;
}

.scroll-area {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-y: contain;
    touch-action: pan-y;
    position: relative;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: #ff3333 rgba(255,0,0,0.2);
    z-index: 1;
}

.scroll-area::-webkit-scrollbar {
    width: 4px;
}

.scroll-area::-webkit-scrollbar-track {
    background: rgba(255,0,0,0.1);
    border-radius: 4px;
}

.scroll-area::-webkit-scrollbar-thumb {
    background: #ff3333;
    border-radius: 4px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 14px;
    padding: 12px 14px;
    padding-bottom: 110px;
}

.card {
    background: rgba(15, 5, 5, 0.9);
    padding: 12px 8px;
    border: 1px solid #ff3333;
    border-radius: 18px;
    text-align: center;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.2, 0.9, 0.4, 1.1);
    backdrop-filter: blur(4px);
