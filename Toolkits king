// ========== RED MATRIX RAIN ==========
const canvas = document.getElementById("matrix");
const ctx = canvas.getContext("2d");
let matrixInterval;

function initMatrix() {
    canvas.height = window.innerHeight;
    canvas.width = window.innerWidth;
    const letters = "01アイウエオカキクケコABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%&*";
    const fontSize = 14;
    let columns = canvas.width / fontSize;
    let drops = [];
    for(let i = 0; i < columns; i++) drops[i] = 1;
    
    function drawMatrix() {
        ctx.fillStyle = "rgba(0,0,0,0.045)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = "#ff0000";
        ctx.font = fontSize + "px monospace";
        ctx.shadowBlur = 8;
        ctx.shadowColor = "#ff0000";
        for(let i = 0; i < drops.length; i++) {
            const text = letters[Math.floor(Math.random() * letters.length)];
            ctx.fillText(text, i * fontSize, drops[i] * fontSize);
            if(drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                drops[i] = 0;
            }
            drops[i]++;
        }
        ctx.shadowBlur = 0;
    }
    
    if (matrixInterval) clearInterval(matrixInterval);
    matrixInterval = setInterval(drawMatrix, 33);
}

window.addEventListener('resize', () => {
    canvas.height = window.innerHeight;
    canvas.width = window.innerWidth;
    if (matrixInterval) {
        clearInterval(matrixInterval);
        initMatrix();
    }
});

function showToast(msg) {
    let toast = document.createElement('div');
    toast.className = 'toast';
    toast.innerHTML = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}

function escapeHtml(str) {
    if(!str) return '';
    return str.replace(/[&<>]/g, m => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;' }[m]));
}

// ========== DATA ==========
let apps = [];
let tools = [];
let currentCat = "all";

async function loadData() {
    const grid = document.getElementById("grid");
    grid.innerHTML = '<div class="empty-msg">🌀 Loading data from server...</div>';
    
    if (!navigator.onLine) {
        showNoInternetCard();
        updateServerStatusUI();
        return;
    }
    
    try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 15000);
        
        const response = await fetch("https://api.jsonbin.io/v3/b/69ca36b836566621a85f91f5", {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' },
            signal: controller.signal
        });
        
        clearTimeout(timeoutId);
        
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        const data = await response.json();
        
        if (!data || !data.record) throw new Error("Invalid API response");
        
        apps = data.record.apps || [];
        tools = data.record.tools || [];
        notifications = data.record.notifications || [];
        
        apps = apps.map(a => ({ 
            ...a, rating: a.rating || 4.2, category: a.category || "Apps",
            download: a.download || "#", name: a.name || "Unknown App",
            developer: a.developer || "WASEEM HACKER",
            icon: a.icon && a.icon.startsWith("http") ? a.icon : "https://via.placeholder.com/55x55/ff3333/000?text=APP"
        }));
        
        tools = tools.map(t => ({ 
            ...t, rating: t.rating || 4.7, download: t.download || "#",
            name: t.name || "Hacker Tool", developer: t.developer || "WASEEM HACKER",
            icon: t.icon && t.icon.startsWith("http") ? t.icon : "https://via.placeholder.com/55x55/ff3333/000?text=TOOL"
        }));
        
        render();
        initMatrix();
        updateServerStatusUI();
        updateNotifBadge();
        
    } catch(e) {
        console.error("Load error:", e);
        showNoInternetCard();
        updateServerStatusUI();
    }
}

function render() {
    const searchText = document.getElementById("search").value.toLowerCase();
    let itemsToShow = [];
    
    if(currentCat === "Tools") {
        itemsToShow = [...tools];
    } else {
        let source = [...apps];
        if(currentCat !== "all") source = source.filter(a => a.category === currentCat);
        itemsToShow = source;
    }
    
    if(searchText && itemsToShow.length) {
        itemsToShow = itemsToShow.filter(item => 
            (item.name && item.name.toLowerCase().includes(searchText)) || 
            (item.developer && item.developer.toLowerCase().includes(searchText))
        );
    }
    
    if(itemsToShow.length === 0) {
        document.getElementById("grid").innerHTML = `<div class="empty-msg">🌀 No items found</div>`;
        return;
    }
    
    let html = "";
    for(let item of itemsToShow) {
        let rating = typeof item.rating === 'number' ? item.rating : 4.2;
        let stars = "";
        let full = Math.floor(rating);
        let half = (rating - full) >= 0.5;
        for(let i=0;i<5;i++) {
            if(i<full) stars += "★";
            else if(i===full && half) stars += "½";
            else stars += "☆";
        }
        
        const iconUrl = (item.icon && item.icon.startsWith("http")) ? item.icon : "https://via.placeholder.com/55x55/ff3333/000?text=APP";
        const safeDownload = (item.download || "#").replace(/'/g, "\\'");
        
        html += `
            <div class="card" onclick="openApp('${safeDownload}')">
                <img class="card-icon" src="${escapeHtml(iconUrl)}" onerror="this.src='https://via.placeholder.com/55x55/ff3333/000?text=IMG'">
                <div class="card-name">${escapeHtml(item.name)}</div>
                <div class="card-rating">${rating.toFixed(1)} ${stars}</div>
                <div class="card-developer">👾 ${escapeHtml(item.developer)}</div>
                <button class="download rgb-active" onclick="event.stopPropagation(); openApp('${safeDownload}')">⬇️ DOWNLOAD</button>
            </div>
        `;
    }
    document.getElementById("grid").innerHTML = html;
}

function openApp(url) {
    if(url && url !== '#' && url !== '' && url !== 'undefined') {
        window.open(url, '_blank');
        showToast("🚀 Opening download link...");
    } else {
        showToast("⚠️ No download link available");
    }
}

