        Connected to WASEEM HACKER servers<br>
        <small>🔒 SECURE CONNECTION</small>
    </div>
</div>

<script>
// ========== NOTIFICATION SYSTEM ==========
let notifications = [];
let lastNotifCount = 0;

async function fetchNotifications() {
    try {
        const response = await fetch("https://api.jsonbin.io/v3/b/69ca36b836566621a85f91f5", {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        notifications = data.record.notifications || [];
        updateNotifBadge();
        
        if(notifications.length > lastNotifCount && lastNotifCount !== 0) {
            let newNotif = notifications[0];
            showToast(`📢 ${newNotif.message.substring(0, 50)}`);
        }
        lastNotifCount = notifications.length;
    } catch(e) {
        console.log("Notif fetch failed");
    }
}

function updateNotifBadge() {
    const badge = document.getElementById("notifBadge");
    const unreadCount = notifications.filter(n => !n.read).length;
    if(unreadCount > 0) {
        badge.style.display = "inline-block";
        badge.innerText = unreadCount > 9 ? "9+" : unreadCount;
    } else {
        badge.style.display = "none";
    }
}

function openNotifications() {
    const modal = document.getElementById("notifModal");
    const notifList = document.getElementById("notifList");
    
    if(notifications.length === 0) {
        notifList.innerHTML = '<div class="empty-notif">📭 No notifications yet</div>';
    } else {
        let html = "";
        for(let i = 0; i < notifications.length; i++) {
            let n = notifications[i];
            let typeClass = n.type || "info";
            html += `
                <div class="notif-item ${typeClass}">
                    <div style="display:flex; align-items:center; gap:6px; margin-bottom:5px;">
                        <span class="notif-time">${n.timestamp || new Date(n.id).toLocaleString()}</span>
                    </div>
                    <div class="notif-message">${escapeHtml(n.message)}</div>
                    <button class="delete-notif" onclick="deleteNotification(${n.id})">🗑</button>
                </div>
            `;
        }
        notifList.innerHTML = html;
    }
    
    notifications.forEach(n => n.read = true);
    updateNotifBadge();
    modal.style.display = "flex";
}

function closeNotifications() {
    document.getElementById("notifModal").style.display = "none";
}

async function deleteNotification(notifId) {
    notifications = notifications.filter(n => n.id !== notifId);
    updateNotifBadge();
    openNotifications();
    showToast("Notification deleted");
    try {
        let apps = [];
        let tools = [];
        const response = await fetch("https://api.jsonbin.io/v3/b/69ca36b836566621a85f91f5", {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();
        apps = data.record.apps || [];
        tools = data.record.tools || [];
        await fetch("https://api.jsonbin.io/v3/b/69ca36b836566621a85f91f5", {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-Master-Key': "$2a$10$IlcTV9Ug9EdYqnMPjEjHCePiNxMz5ryUvA9qTzk52goNQL7CYDAYW" },
            body: JSON.stringify({ apps, tools, notifications })
        });
    } catch(e) {}
}

